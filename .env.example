# --- Required ---
# Anthropic API key for the scoring engine. This is the ONLY secret Litmus needs;
# Kalshi and Polymarket market data are read from public, keyless endpoints.
ANTHROPIC_API_KEY=

# --- Models (optional; sensible defaults in code) ---
# Opus-class does rubric scoring + cross-venue rule-diffing; Haiku-class does the
# cheap passes (directional lean, verdict compression, pair-match confirmation).
LITMUS_MODEL=claude-opus-4-8
# LEAN_MODEL=claude-haiku-4-5
# CROSSVENUE_MATCH_MODEL=claude-haiku-4-5
# Pin the API host so an ambient proxy can't misroute the standalone key.
# LITMUS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Cost controls (optional) ---
# Hard daily spend cap in USD. Halts SCORING when exceeded; never halts grading or
# locking (those are free). 0 is a valid "spend nothing today" stop.
LITMUS_DAILY_BUDGET_USD=10
# Pre-approve runs that would score >50 new items (for unattended/CI use).
# LITMUS_YES=1

# --- Coverage / cost knobs (optional; code has defaults) ---
# KALSHI_MIN_CONTRACTS=10000     # min Kalshi volume to ingest a market
# POLY_MIN_VOLUME=100000         # min Polymarket USD volume to ingest
# INGEST_MAX=90                  # max rulebooks ingested per venue per run
# BACKFILL_MAX=0                 # 0 = score all unscored; >0 = cap to N highest-volume
# COHORT_SHARE=0.25              # share of ingest reserved for near-term, mid-priced markets

# --- Fast-scan watcher (optional) ---
# WATCHER_POLL_MINUTES=5
# FASTSCAN_MIN_HORIZON_HOURS=48  # skip sub-48h templated micro-markets

# API base URLs are defaulted in code; override only to point at a mock.
# KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
