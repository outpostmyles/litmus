# --- Scoring engine (required) ---
# Standalone Anthropic API key for the resolution-risk engine (separate from Claude Code).
ANTHROPIC_API_KEY=

# Model used by the scoring engine. Defaults to a current Claude model if unset.
LITMUS_MODEL=claude-opus-4-8

# --- Storage (Phase B) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Polymarket (read-only, no auth needed for Gamma/CLOB data reads) ---
# Base URLs are defaulted in code; override only if needed.
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_URL=https://clob.polymarket.com

# --- Kalshi (only if/when we add the Kalshi adapter) ---
# Kalshi requires an API key id + an RSA private key for request signing.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
